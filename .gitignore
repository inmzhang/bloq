# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target

# Output files for block compilation
out
/output
*.html
!bloq_editor/web/index.html
!docs/_templates/**/*.html
*.gltf

# Agents related
PLAN.md
notes.md
/.ppr
.claude.local.md
.omx
/.ask-pro/

# temp files
/tmp
pdfs/
# worktrees
worktrees
# test purpose
testdata
# but keep committed fixtures that live in a testdata/ dir
!bloq_compile/src/block/fixed_bulk/t/testdata/
!bloq_compile/src/block/fixed_bulk/testdata/
.DS_Store

# Benchmark results stay local.

# Python packaging: `maturin develop` drops the extension module into the
# source tree; bytecode caches are per-interpreter noise. The generated
# `.pyi` stubs under bloq_py/python/ ARE tracked (regenerate: `just py-stub`).
bloq_py/python/bloq/*.so
__pycache__/
# uv-managed venv (`just py-develop`); uv.lock IS tracked
bloq_py/.venv/

# Python API reference: HTML output and autosummary-generated per-item pages
docs/_build/
docs/api/_autosummary/
