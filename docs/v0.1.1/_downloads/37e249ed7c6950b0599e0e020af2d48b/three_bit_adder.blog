  branch cz0 {
    false {
      217: XZX [10, 1, 12] <cz_target_0_off>
      218: XXZ [11, 1, 12] <cz_q_contact_0>
      22 -> +Z
      217 -> +Z
    }
    true {
      219: ZXZ [10, 1, 12] <cz_target_0_on>
      220: XXZ [11, 1, 12] <cz_q_contact_0>
      22 -H> +Z
      219 -H> +Z
      219 -> +X
    }
  }
  branch cz1 {
    false {
      221: XZX [10, 4, 12] <cz_target_1_off>
      222: XXZ [11, 4, 12] <cz_q_contact_1>
      87 -> +Z
      221 -> +Z
    }
    true {
      223: ZXZ [10, 4, 12] <cz_target_1_on>
      224: XXZ [11, 4, 12] <cz_q_contact_1>
      87 -H> +Z
      223 -H> +Z
      223 -> +X
    }
  }
  branch cz2 {
    false {
      225: XZX [10, 7, 12] <cz_target_2_off>
      226: XXZ [11, 7, 12] <cz_q_contact_2>
      180 -> +Z
      225 -> +Z
    }
    true {
      227: ZXZ [10, 7, 12] <cz_target_2_on>
      228: XXZ [11, 7, 12] <cz_q_contact_2>
      180 -H> +Z
      227 -H> +Z
      227 -> +X
    }
  }

  resolve cz0 if bit0_uma.erase
  resolve cz1 if bit1_uma.erase
  resolve cz2 if bit2_tail.m_ikprime

  bit0_and.qi_k -> 0
  0 -> bit0_maj.i_prime_k
  bit0_maj.c_k_plus_1_duplicate -> bit0_uma.c_k_plus_1
  bit0_maj.c_k_xor_i_prime_k -> bit0_uma.i_prime_k
  bit0_maj.c_k_xor_t_k -H> bit0_uma.t_k
  67 -> bit0_and.q
  26 -> bit0_and.i_k
  40 -> bit0_maj.t_k
  bit0_uma.out_k -> 42
  52 -> bit0_and.ccz_2
