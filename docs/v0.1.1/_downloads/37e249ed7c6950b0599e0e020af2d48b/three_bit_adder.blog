  bit1_maj.c_k_plus_1_duplicate -> bit1_uma.c_k_plus_1
  bit1_maj.c_k_xor_i_prime_k -> bit1_uma.c_k_xor_i_prime_k
  bit1_maj.c_k_xor_t_k -H> bit1_uma.c_k_xor_t_k
  bit1_maj.c_k_out -H> bit1_uma.c_k
  132 -> bit1_and.q
  94 -> bit1_and.i_k
  108 -> bit1_maj.t_k
  bit1_uma.out_k -> 110
  120 -> bit1_and.ccz_2
