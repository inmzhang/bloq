  bit0_maj.c_k_plus_1 -> bit1_maj.c_k
  135 -> bit2_tail.t_k
  bit2_tail.out_k -> 136
  bit2_and.qi_k -> 140
  140 -> bit2_tail.i_prime_k
  158 -> bit2_and.q
  185 -> bit2_and.i_k
  212 -> bit2_and.ccz_2
  213 -> bit2_and.ccz_0
  214 -> bit2_and.ccz_1
  bit1_maj.c_k_plus_1 -> bit2_tail.c_k
  bit1_uma.carry_z => bit0_uma.incoming_z
  bit2_tail.m_ikprime => bit1_uma.incoming_z
}
