diff --git a/tests/test_routing_budget.py b/tests/test_routing_budget.py
new file mode 100644
index 0000000..4befdae
--- /dev/null
+++ b/tests/test_routing_budget.py
@@ -0,0 +1,72 @@
+"""Finite routing budgets scale with source depth and honor explicit limits."""
+
+import pytest
+
+from pyzx_routing import (
+    RoutingError,
+    ScheduleAdapterError,
+    route_parallel_schedule,
+    validate_routing_result,
+)
+
+
+def idle_schedule(depth):
+    # A persistent patch with empty logical slots isolates depth budgeting
+    # from path search, gate synthesis, and geometry heuristics.
+    return {
+        "slots": tuple({"time": t, "measurements": ()} for t in range(1, depth + 1)),
+        "zero_time_events": (
+            {"after_time": 0, "kind": "PREPARE_INPUT", "patch": 0,
+             "target_instruction": 0, "dag_node_id": 0, "dependency_node_ids": ()},
+            {"after_time": depth, "kind": "H_OUTPUT", "patch": 0,
+             "target_instruction": 1, "dag_node_id": 1, "dependency_node_ids": (0,)},
+        ),
+        "source_peak_data_patches": 1,
+    }
+
+
+def test_automatic_budget_routes_a_schedule_longer_than_the_old_cap():
+    schedule = idle_schedule(1001)
+    routed = route_parallel_schedule(schedule)
+    validate_routing_result(routed, schedule)
+    assert routed.depth == 1001
+    assert routed.parameters["max_physical_layers"] == 2003
+
+
+@pytest.mark.parametrize("options", [
+    {"max_physical_layers": 2},
+    {"max_layers": 2},
+    {"max_physical_layers": 2, "max_layers": 2},
+])
+def test_explicit_budget_and_alias_remain_exact_hard_caps(options):
+    schedule = idle_schedule(2)
+    routed = route_parallel_schedule(schedule, **options)
+    validate_routing_result(routed, schedule)
+    assert routed.parameters["max_physical_layers"] == 2
+
+
+@pytest.mark.parametrize("options", [
+    {"max_physical_layers": 1}, {"max_layers": 1},
+])
+def test_explicit_budget_below_source_depth_explains_the_preflight_failure(options):
+    with pytest.raises(RoutingError, match="below required source depth 2"):
+        route_parallel_schedule(idle_schedule(2), **options)
+
+
+def test_explicit_old_default_no_longer_masks_a_conflicting_alias():
+    with pytest.raises(ValueError, match="disagree"):
+        route_parallel_schedule(idle_schedule(1), max_physical_layers=1000, max_layers=999)
+
+
+@pytest.mark.parametrize("options", [
+    {"max_physical_layers": True},
+    {"max_layers": True},
+    {"max_physical_layers": True, "max_layers": 1},
+    {"max_physical_layers": 1, "max_layers": True},
+    {"max_physical_layers": 0},
+    {"max_layers": 0},
+    {"max_physical_layers": 1.5},
+])
+def test_invalid_explicit_budgets_reject(options):
+    with pytest.raises((ValueError, ScheduleAdapterError)):
+        route_parallel_schedule(idle_schedule(1), **options)
