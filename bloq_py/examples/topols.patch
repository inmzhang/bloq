+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn ceiling_lift_preserves_branching_spider_color() {
+        let node = NodeId::int(0);
+        for kind in [0, 1, 4, 5] {
+            for outgoing in [1, 2] {
+                let state = EmbeddingState::new(
+                    NodeMap::from([(node, Cell::new(0, -1, 0))]),
+                    NodeMap::from([(node, Axis::J)]), NodeMap::from([(node, kind)]),
+                    Paths::new(), i32::MIN, occ_from([Cell::new(0, -1, 0)]),
+                    -1.0, Floors::all(-10.0, 10.0, -10.0, 10.0),
+                    NodeMap::new(), NodeMap::new(), NodeMap::new(),
+                    Arc::new(Layer {
+                        node_type: NodeMap::from([(node, kind)]),
+                        output_connect: NodeMap::from([(node, outgoing)]),
+                        inter_connect: vec![],
+                    }),
+                    Arc::new(NodeMap::new()), Arc::new(vec![]),
+                    1.0, Arc::new(HTable::default()), 0,
+                );
+                let lifted = &state.reward(1).unwrap().ceiling_track[&node];
+                assert_eq!(lifted.typ, if outgoing > 1 { kind } else { i8::from(kind != 1) });
+                assert_eq!(lifted.ori, Some(if outgoing > 1 { Axis::K } else { Axis::I }));
+            }
+        }
+    }
+
+    #[test]
+    fn s_stub_stays_above_the_finished_layer() {
+        let input = NodeId::int(14);
+        let node = NodeId::int(17);
+        let state = EmbeddingState::new(
+            NodeMap::from([(input, Cell::new(1, 2, 6))]),
+            NodeMap::from([(input, Axis::I)]), NodeMap::from([(input, 0)]),
+            Paths::new(), i32::MIN, occ_from([Cell::new(1, 2, 6)]),
+            5.0, Floors::all(-10.0, 10.0, -10.0, 10.0),
+            NodeMap::new(), NodeMap::new(), NodeMap::new(),
+            Arc::new(Layer {
+                node_type: NodeMap::from([(node, 4)]),
+                output_connect: NodeMap::from([(node, 1)]),
+                inter_connect: vec![],
+            }),
+            Arc::new(NodeMap::from([(node, vec![input])])), Arc::new(vec![node]),
+            1.0, Arc::new(HTable::default()), 0,
+        );
+        assert!(state.next_state(Cell::new(1, 2, 5)).is_none());
+        let legal = state.next_state(Cell::new(1, 2, 7)).unwrap();
+        assert!(legal.paths.iter().flatten().all(|p| p.z >= 5));
+    }
+}
