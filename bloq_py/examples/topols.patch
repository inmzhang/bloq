@@ -0,0 +1,101 @@
+"""Source-preserving fallback layers and magic-state outlet routing."""
+
+import unittest
+from pathlib import Path
+from tempfile import TemporaryDirectory
+from types import SimpleNamespace
+
+import pyzx as zx
+from topols.embedding.hadamard import HTable
+from topols.engine import block_payload, run_rust
+from topols.pipeline import fallback_block, prepare_graph
+from topols.routing.boundary import route_single_T_to_boundary
+from topols.zx_transform.layering import layer_info
+
+
+class FallbackFrontierTests(unittest.TestCase):
+    def test_empty_and_populated_frontiers_preserve_cnot_and_final_t(self):
+        for gate in ("h", "s"):
+            with self.subTest(frontier=gate):
+                circuit = zx.Circuit.from_qasm(
+                    'OPENQASM 2.0;\ninclude "qelib1.inc";\nqreg q[2];\n'
+                    f'{gate} q[0]; cx q[0],q[1]; t q[1];\n'
+                )
+                prep = SimpleNamespace(circuit=circuit, block_info={1: [2, 3]},
+                                       idx_to_row=dict(enumerate(range(5))), h_table=HTable())
+                graph, labels, _ = fallback_block(circuit, 1, prep.block_info, prep.idx_to_row)
+                # The inherited row 1 may disappear with its Hadamard. Both
+                # engines must still execute the CNOT in 1 and final T in 2.
+                self.assertEqual(sorted(layer_info(graph, labels, 1)[3].values()), [0, 1])
+                self.assertIn(5, layer_info(graph, labels, 2)[3].values())
+                layers = block_payload(prep, 1)["layers"]
+                self.assertEqual(len(layers), max(labels.values()) + 1)
+                self.assertEqual(sorted(dict(layers[1]["node_type"]).values()), [0, 1])
+                self.assertIn(5, dict(layers[2]["node_type"]).values())
+
+    def test_both_drivers_execute_first_cnot_and_final_t(self):
+        from topols.driver import operation
+
+        qasm = 'OPENQASM 2.0;\ninclude "qelib1.inc";\nqreg q[2];\nh q[0]; cx q[0],q[1]; t q[1];\n'
+        with TemporaryDirectory() as temporary:
+            path = Path(temporary) / "source.qasm"
+            path.write_text(qasm)
+            for engine in ("python", "rust"):
+                with self.subTest(engine=engine):
+                    prep = prepare_graph(path, block_size_max=1, zx_opt=0, dir_opt=0)
+                    # No MCTS iterations forces the gate-by-gate fallback.
+                    if engine == "rust":
+                        try:
+                            import topols_core  # noqa: F401
+                        except ImportError:
+                            self.skipTest("optional topols_core extension is not installed")
+                        history = run_rust(prep, {
+                            "seed_init": 1330, "seed_step": 1, "time_bound": .01, "iter_num": 0,
+                            "move_num": 6, "length": 2, "dir_opt": False, "backtrack": 0, "z_floor": 1,
+                        })[2]
+                    else:
+                        history = operation(
+                            prep.circuit, prep.graph, prep.layer_labels, prep.layer_to_block,
+                            prep.block_info, prep.idx_to_row, prep.rows, prep.q_num,
+                            z_floor=1, seed_init_tuple=(1330, 1), time_bound=.01, iter_num=0,
+                            move_num=6, length=2, dir_opt=0, hadamard_edges=prep.h_table,
+                            io_info=prep.io_info,
+                        )[4]
+                    source = prep.circuit.to_graph()
+                    expected = {v: 1 if source.type(v) == zx.VertexType.X else 0
+                                for v in source.vertices() if source.vertex_degree(v) == 3}
+                    expected.update({v: 5 for v in source.vertices() if source.phase(v) == 1 / 4})
+                    for vertex, kind in expected.items():
+                        self.assertTrue(any(str(n).split("_")[0] == str(vertex) and t == kind
+                                            for n, t in history.items()), (engine, vertex, kind))
