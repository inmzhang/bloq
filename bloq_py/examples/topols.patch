+class TOutletTests(unittest.TestCase):
+    def route(self, orientation):
+        source = (-2, 0, 1)
+        occupied = {source, (-2, -1, 1), (-2, -1, 2)}
+        before = occupied.copy()
+        result = route_single_T_to_boundary(
+            source, occupied, set(), 1, 3, -1, 1, -1, 1, orientation,
+        )
+        return source, before, result
+
+    def test_initial_outlet_has_a_nonzero_arm(self):
+        for orientation in ("i", "j", "k"):
+            with self.subTest(orientation=orientation):
+                source, _, (target, path, _, orientation) = self.route(orientation)
+                self.assertIsNotNone(target)
+                self.assertNotEqual(target, source)
+                self.assertGreaterEqual(len(path), 2)
+                self.assertEqual(path[0], source)
+                self.assertEqual(path[-1], target)
+                self.assertEqual(orientation, 0)
+
+    def test_an_existing_arm_may_stay_at_its_boundary(self):
+        source, occupied, (target, path, after, orientation) = self.route(0)
+        self.assertEqual((target, path, orientation), (source, (source,), 0))
+        self.assertEqual(after, occupied)
