diff --git a/rust/topols_core/tests/outlets.rs b/rust/topols_core/tests/outlets.rs
new file mode 100644
index 0000000..ac5829b
--- /dev/null
+++ b/rust/topols_core/tests/outlets.rs
@@ -0,0 +1,58 @@
+//! A new magic resource needs an arm; an already routed exit may stay put.
+
+use topols_core::geometry::{Cell, Floors};
+use topols_core::routing::astar::Occ;
+use topols_core::routing::boundary::route_single_t_to_boundary;
+use topols_core::routing::color::Axis;
+
+#[test]
+fn initial_t_outlet_has_a_nonzero_arm() {
+    let source = Cell::new(-2, 0, 1);
+    for orientation in [Axis::I, Axis::J, Axis::K] {
+        let mut occupied: Occ = [source, Cell::new(-2, -1, 1), Cell::new(-2, -1, 2)]
+            .into_iter()
+            .collect();
+        let result = route_single_t_to_boundary(
+            source,
+            &mut occupied,
+            &Occ::default(),
+            1.0,
+            3.0,
+            Floors::all(-1.0, 1.0, -1.0, 1.0),
+            Some(orientation),
+            3,
+            &[],
+        );
+        let target = result.target.expect("a neighboring boundary cell is free");
+        let path = result.path.unwrap();
+        assert_ne!(target, source, "orientation {orientation:?}");
+        assert!(path.len() >= 2);
+        assert_eq!(path.first(), Some(&source));
+        assert_eq!(path.last(), Some(&target));
+        assert_eq!(result.ori, None);
+    }
+}
+
+#[test]
+fn an_existing_t_arm_may_stay_at_its_boundary() {
+    let source = Cell::new(-2, 0, 1);
+    let mut occupied: Occ = [source, Cell::new(-2, -1, 1), Cell::new(-2, -1, 2)]
+        .into_iter()
+        .collect();
+    let before = occupied.clone();
+    let result = route_single_t_to_boundary(
+        source,
+        &mut occupied,
+        &Occ::default(),
+        1.0,
+        3.0,
+        Floors::all(-1.0, 1.0, -1.0, 1.0),
+        None,
+        3,
+        &[],
+    );
+    assert_eq!(result.target, Some(source));
+    assert_eq!(result.path, Some(vec![source]));
+    assert_eq!(result.ori, None);
+    assert_eq!(occupied, before);
+}
