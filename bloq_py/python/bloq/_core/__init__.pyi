        """
    def blocks(self) -> builtins.list[Block]:
        r"""
        Blocks authored in this definition's local body, excluding child instances.
        """
    def pipes(self) -> builtins.list[Pipe]:
        r"""
        Pipes authored in this definition's local body, excluding child instances.
        """
    def positions(self) -> builtins.list[tuple[builtins.int, builtins.int, builtins.int]]:
        r"""
        Positions of this definition's local blocks, excluding child instances.
        """
    def occupied_positions(self) -> builtins.list[tuple[builtins.int, builtins.int, builtins.int]]:
        r"""
