            BlockGraphError: If the graph retains module structure.
        """
    def export_gltf(self, path: builtins.str | os.PathLike | pathlib.Path, pipe_length: builtins.float = 2.0, stabilizer: typing.Optional[StabilizerGenerator  |  typing.Sequence[builtins.int]] = None, pop_faces_at_directions: typing.Optional[typing.Sequence[Direction  |  builtins.str]] = None, pop_faces_at_blocks: typing.Optional[typing.Sequence[tuple[tuple[builtins.int, builtins.int, builtins.int], Direction  |  builtins.str]]] = None, pop_faces_at_pipes: typing.Optional[typing.Sequence[tuple[tuple[builtins.int, builtins.int, builtins.int], tuple[builtins.int, builtins.int, builtins.int], Direction  |  builtins.str]]] = None, module_view: builtins.bool = False) -> None:
        r"""
