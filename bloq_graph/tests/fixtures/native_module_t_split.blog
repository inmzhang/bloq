BLOG 1.0

# One T gadget spans three owners: data in the root, source in one child, cap in another.
module TSource {
  in side: data = 0
  out top: data = 3
  out m = mzz
  0: Port [0, 0, 0] role=input <side>
  1: XZX [1, 0, 0]
  2: T [1, 0, -1]
  3: Port [1, 0, 1] role=output <top>
  [0, 0, 0] -> +X
  [1, 0, -1] -> +Z
  [1, 0, 0] -> +Z
  mzz = measure 0 -> +X
}

module CapOnly {
  in q: data = 0
  in basis
  0: Port [0, 0, 0] role=input
  1: YX [0, 0, 1]
  [0, 0, 1] -> -Z
  resolve 1 if basis
}

module main {
  in q_in: data = 100
  out q_out: data = 101
  t: TSource @ [0, 0, 1]
  c: CapOnly @ [1, 0, 1]
  100: Port [0, 0, 0] role=input <q_in>
  1: XZX [0, 0, 1]
  101: Port [0, 0, 2] role=output <q_out>
  [0, 0, 0] -> +Z
  [0, 0, 1] -> +Z
  1 -> t.side
  t.top -> c.q
  t.m => c.basis
}
