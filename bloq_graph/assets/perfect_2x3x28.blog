# Bloq corrects logical readouts and output frames globally. Latte Pauli
# feedback-only readouts disappear; split injection outcomes name one parity.
# A terminal Latte Z spider measures X, so Y/Z choices use YX caps.

m0_2_ = measure [1, 0, 7] -> +Y
resolve [1, 1, 8] if m0_2_
t0 = measure [0, 0, 15] -> +X
t1 = measure [0, 1, 15] -> +X
m01_3 = measure [0, 1, 18] -> +X
resolve [1, 0, 20] if m01_3
m012_ = measure [0, 1, 23] -> +X
resolve [0, 1, 24] if t1
s1 = measure [0, 1, 24]
resolve [1, 1, 25] if m012_
m0_23 = measure [1, 0, 26] -> +Y
resolve [0, 0, 27] if t0
resolve [0, 1, 27] if m0_23
s0 = measure [0, 0, 27]
# These corrected check bits already include the source's intermediate frames.
discard if t0 ^ s0
discard if t1 ^ s1
# The source includes this unconditional X after the square-root-X stage.
feedback X [0, 0, 10]
}
