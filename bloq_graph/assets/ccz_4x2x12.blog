pair = (m12_4 & m1234) ^ (m12_4 & m1_34) ^ (m12_4 & m_234) ^ (m1234 & m1_34) ^ (m1234 & m_234) ^ (m1_34 & m_234)
resolve [0, 1, 10] if s4
cmp = measure [0, 1, 10]
discard if cmp ^ pair
feedback X [1, 0, 12] if m_234
feedback Z [2, 0, 12] if m_234
feedback Z [3, 0, 12] if m_234
feedback Z [1, 0, 12] if m1_34
feedback X [2, 0, 12] if m1_34
