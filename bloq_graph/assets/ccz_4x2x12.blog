feedback X [1, 0, 12]
feedback X [2, 0, 12]
feedback X [3, 0, 12]
resolve check_q1 if s1
resolve correct_q1 if s1
resolve check_q2 if s2
resolve correct_q2 if s2
resolve check_q3 if s3
resolve correct_q3 if s3
}
