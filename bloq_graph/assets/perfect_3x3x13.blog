# Bloq corrects logical readouts and output frames globally. Latte Pauli
# feedback-only readouts disappear; split injection outcomes name one parity.
# A terminal Latte Z spider measures X, so Y/Z choices use YX caps.

m0_2_ = measure [1, 0, 4] -> +Y
resolve [2, 1, 5] if m0_2_
t0 = measure [0, 0, 6] -> +X
t1 = measure [0, 2, 6] -> +X
m01_3 = measure [1, 0, 8] -> +Y
resolve [2, 1, 9] if m01_3
m012_ = measure [1, 0, 9] -> +Y
resolve [0, 1, 10] if m012_
resolve [0, 2, 10] if t1
s1 = measure [0, 2, 10]
m0_23 = measure [1, 1, 11] -> +Y
resolve [0, 0, 12] if t0
resolve [2, 1, 12] if m0_23
s0 = measure [0, 0, 12]
# These corrected check bits already include the source's intermediate frames.
discard if t0 ^ s0
discard if t1 ^ s1
