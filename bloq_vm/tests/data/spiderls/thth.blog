BLOG 1.0

module main {
  in in_0: data = 0
  out out_0: data = 11

  0: Port [0, 0, 0] role=input
  1: ZXX [0, 0, 1]
  2: ZXX [0, 1, 1]
  3: ZXX [0, 2, 1]
  4: ZXX [0, 3, 1]
  5: ZXX [0, 4, 1]
  6: XZX [0, 0, 2]
  7: XZX [1, 0, 2]
  8: XZX [2, 0, 2]
  9: XZX [3, 0, 2]
  10: XZX [4, 0, 2]
  11: Port [0, 0, 3] role=output
  12: T [0, 4, 0]
  13: XY [0, 4, 2]
  14: T [4, 0, 1]
  15: XY [4, 0, 3]
  0 -> +Z
  1 -> +Y
  1 -H> +Z
  2 -> +Y
  3 -> +Y
  4 -> +Y
  5 -> +Z
  6 -> +X
  6 -H> +Z
  7 -> +X
  8 -> +X
  9 -> +X
  10 -> +Z
  12 -> +Z
  14 -> +Z

  spiderls_t_1 = measure 4 -> +Y
  resolve 13 if !spiderls_t_1
  spiderls_t_3 = measure 9 -> +X
  resolve 15 if !spiderls_t_3

}
