BLOG 1.0

module main {
  in in_0: data = 0
  in in_1: data = 1
  out out_0: data = 4
  out out_1: data = 5

  0: Port [0, 0, 0] role=input
  1: Port [0, 3, 0] role=input
  2: ZXX [0, 0, 1]
  3: ZXX [0, 3, 1]
  4: Port [0, 0, 2] role=output
  5: Port [0, 3, 2] role=output
  0 -> +Z
  1 -> +Z
  2 -> +Z
  3 -> +Z

  feedback X 0 -> +Z
  feedback X 1 -> +Z

}
