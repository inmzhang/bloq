BLOG 1.0

module main {
  in in_0: data = 0
  in in_1: data = 1
  out out_0: data = 4
  out out_1: data = 5

  0: Port [0, 0, 0] role=input
  1: Port [0, 9, 0] role=input
  2: XZX [0, 0, 3]
  3: XZX [0, 9, 3]
  4: Port [0, 0, 6] role=output
  5: Port [0, 9, 6] role=output
  6: ZXX [0, 0, 1]
  7: XZX [0, 0, 2]
  8: ZXX [0, 9, 1]
  9: XZX [0, 9, 2]
  10: XZX [0, 0, 4]
  11: ZXX [0, 0, 5]
  12: XZX [0, 9, 4]
  13: ZXX [0, 9, 5]
  0 -> +Z
  1 -> +Z
  2 -> +Z
  3 -> +Z
  6 -H> +Z
  7 -> +Z
  8 -H> +Z
  9 -> +Z
  10 -H> +Z
  11 -> +Z
  12 -H> +Z
  13 -> +Z

  feedback Z 2 -> +Z
  feedback Z 3 -> +Z

}
