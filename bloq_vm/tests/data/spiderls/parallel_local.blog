BLOG 1.0

module main {
  in in_0: data = 0
  in in_1: data = 1
  out out_0: data = 4
  out out_1: data = 5

  0: Port [0, 0, 0] role=input
  1: Port [0, 9, 0] role=input
  2: XZX [0, 0, 1]
  3: XZX [0, 9, 1]
  4: Port [0, 0, 3] role=output
  5: Port [0, 9, 3] role=output
  6: XZX [0, 0, 2]
  7: XZX [0, 9, 2]
  0 -H> +Z
  1 -H> +Z
  2 -> +Z
  3 -> +Z
  6 -H> +Z
  7 -H> +Z

  feedback Z 2 -> +Z
  feedback Z 3 -> +Z

}
