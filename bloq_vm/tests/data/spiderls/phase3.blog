BLOG 1.0

module main {
  in in_0: data = 0
  out out_0: data = 6

  0: Port [0, 0, 0] role=input
  1: ZXX [0, 0, 1]
  2: ZXX [0, 1, 1]
  3: ZXX [0, 2, 1]
  4: ZXX [0, 3, 1]
  5: ZXX [0, 4, 1]
  6: Port [0, 0, 2] role=output
  7: T [0, 4, 0]
  8: XY [0, 4, 2]
  0 -> +Z
  1 -> +Y
  1 -> +Z
  2 -> +Y
  3 -> +Y
  4 -> +Y
  5 -> +Z
  7 -> +Z

  spiderls_t_1 = measure 4 -> +Y
  resolve 8 if spiderls_t_1
  feedback Z 4 -> +Y

}
