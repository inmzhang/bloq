BLOG 1.0

module main {
  in in_0: data = 0
  out out_0: data = 2

  0: Port [0, 0, 0] role=input
  1: XZX [0, 0, 3]
  2: Port [0, 0, 6] role=output
  3: ZXX [0, 0, 1]
  4: XZX [0, 0, 2]
