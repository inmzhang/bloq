BLOG 1.0

module main {
  in in_0: data = 0
  in in_1: data = 7
  out out_0: data = 6
  out out_1: data = 8

  0: Port [0, 0, 0] role=input
  1: ZXX [0, 0, 1]
  2: ZXX [0, 1, 1]
  3: ZXX [0, 2, 1]
  4: ZXX [0, 3, 1]
  5: ZXX [0, 4, 1]
  6: Port [0, 0, 2] role=output
  7: Port [6, 0, 0] role=input
  8: Port [6, 0, 2] role=output
  9: ZXX [6, 0, 1]
  10: T [0, 4, 0]
  11: XY [0, 4, 2]
  0 -> +Z
  1 -> +Y
  1 -> +Z
  2 -> +Y
  3 -> +Y
  4 -> +Y
  5 -> +Z
  7 -> +Z
  9 -> +Z
  10 -> +Z

  spiderls_t_1 = measure 4 -> +Y
  resolve 11 if !spiderls_t_1

}
