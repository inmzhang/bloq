BLOG 1.0

module main {
  in in_0: data = 0
  in in_1: data = 7
  out out_0: data = 6
  out out_1: data = 8

  0: Port [0, 0, 0] role=input
  1: ZXX [0, 0, 2]
  2: ZXX [0, 1, 2]
  3: ZXX [0, 2, 2]
  4: ZXX [0, 3, 2]
  5: ZXX [0, 4, 2]
  6: Port [0, 0, 4] role=output
  7: Port [6, 0, 0] role=input
  8: Port [6, 0, 4] role=output
  9: ZXX [6, 0, 2]
  10: ZXX [0, 0, 1]
  11: ZXX [0, 0, 3]
  12: ZXX [6, 0, 1]
  13: ZXX [6, 0, 3]
  14: T [0, 4, 1]
  15: XY [0, 4, 3]
  0 -> +Z
  1 -> +Y
  1 -> +Z
  2 -> +Y
  3 -> +Y
  4 -> +Y
  5 -> +Z
  7 -> +Z
  9 -> +Z
  10 -> +Z
  11 -> +Z
  12 -> +Z
  13 -> +Z
  14 -> +Z

  spiderls_t_1 = measure 4 -> +Y
  resolve 15 if !spiderls_t_1

}
