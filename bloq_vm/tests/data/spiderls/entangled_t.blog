BLOG 1.0

module main {
  in in_0: data = 0
  in in_1: data = 1
  out out_0: data = 15
  out out_1: data = 16

  0: Port [0, 0, 0] role=input
  1: Port [0, 3, 0] role=input
  2: XZX [0, 0, 1]
  3: XZX [0, 3, 1]
  4: XZZ [-1, 0, 1]
  5: XZZ [-1, 1, 1]
  6: XZZ [-1, 2, 1]
  7: ZZX [-1, 3, 1]
  8: XZX [0, 0, 2]
  9: ZXX [0, 3, 2]
  10: XZX [-1, 0, 2]
  11: ZXX [0, 4, 2]
  12: ZXX [0, 5, 2]
  13: ZXX [0, 6, 2]
  14: ZXX [0, 7, 2]
  15: Port [0, 0, 3] role=output
  16: Port [0, 3, 3] role=output
  17: T [0, 7, 1]
  18: XY [0, 7, 3]
  0 -H> +Z
  1 -H> +Z
  2 -> +Z
  3 -H> +Z
  4 -> +Y
  4 -> +Z
  5 -> +Y
  6 -H> +Y
  7 -> +X
  8 -> +Z
  9 -> +Y
  9 -> +Z
  10 -> +X
  11 -> +Y
  12 -> +Y
  13 -> +Y
  14 -> +Z
  17 -> +Z

  spiderls_t_7 = measure 13 -> +Y
  resolve 18 if !spiderls_t_7

}
