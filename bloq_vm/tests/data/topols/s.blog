BLOG 1.0

module main {
  in in_0: data = 0
  out out_0: data = 2

  0: Port [0, 0, 0] role=input
  1: ZXX [0, 0, 1]
  2: Port [0, 0, 4] role=output
  3: Y [0, -1, 3]
  4: ZXX [0, -1, 1]
  5: ZXZ [0, 0, 3]
  6: ZXX [0, -1, 2]
  7: ZXX [0, 0, 2]
  0 -> +Z
  1 -> +Z
  4 -> +Y
  4 -> +Z
  5 -> +Z
  6 -> +Z
  7 -> +Z

  feedback Z 1 -> +Z

}
