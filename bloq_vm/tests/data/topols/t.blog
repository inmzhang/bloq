BLOG 1.0

module main {
  in in_0: data = 0
  out out_0: data = 2

  0: Port [0, 0, 0] role=input
  1: ZXX [0, 0, 2]
  2: Port [0, 0, 4] role=output
  3: XZX [2, -1, 2]
  4: ZZX [0, -1, 2]
  5: ZZX [1, -1, 2]
  6: ZXX [0, 0, 1]
  7: ZXX [0, 0, 3]
  8: T [2, -1, 1]
  9: XY [2, -1, 3]
  0 -> +Z
  1 -> +Z
  3 -> +Z
  4 -> +Y
  4 -> +X
  5 -> +X
  6 -> +Z
  7 -> +Z
  8 -> +Z

  topols_t_1_old_t = measure 5 -> +X
  resolve 9 if !topols_t_1_old_t

}
