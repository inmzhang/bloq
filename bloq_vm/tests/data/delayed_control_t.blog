BLOG 1.0

module main {
  in in_0: data = 11
  out out_0: data = 2

  0: ZXZ [0, 0, 1]
  1: XXZ [1, 0, 1]
  2: Port [2, 0, 3] role=output
  3: T [1, 1, 0]
  4: XY [1, -1, 2]
  5: ZXZ [2, 0, 1]
  6: ZXX [2, 0, 2]
  7: XZZ [1, 1, 1]
  8: XZZ [1, -1, 1]
  9: ZXZ [0, 0, 2]
  10: ZXZ [0, 0, 3]
  11: Port [0, 0, 4] role=input
  0 -> +X
  0 -> +Z
  1 -> +X
  1 -> +Y
  3 -> +Z
  5 -> +Z
  6 -> +Z
  8 -> +Y
  8 -> +Z
  9 -> +Z
  10 -> +Z

  m = measure 7
  resolve 4 if !m
  feedback Z 1 -> -Y if m
}
