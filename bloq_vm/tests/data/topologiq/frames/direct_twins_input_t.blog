BLOG 1.0

module main {
  in in_0: data = 6
  out out_0: data = 5

  0: T [1, 1, 1]
  1: XY [1, 1, 3]
  2: XZX [2, 1, 1]
  3: XZX [2, 1, 2]
  4: XZX [1, 1, 2]
  5: Port [0, 1, 2] role=output
  6: Port [2, 1, 0] role=input
  0 -> +Z
  2 -> +Z
  4 -> +Z
  4 -> +X
  5 -> +X
  6 -> +Z

  topologiq_t_11 = measure 3 -> -X
  resolve 1 if !topologiq_t_11
  feedback X 4 -> -X if topologiq_t_11

