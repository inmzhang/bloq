BLOG 1.0

module main {
  in in_0: data = 0
  out out_0: data = 2

  0: Port [-1, 3, 1] role=input
  1: ZXX [-1, 4, 1]
  2: Port [-1, 5, 1] role=output
  3: T [-1, 4, 0]
  4: XY [-1, 4, 5]
  5: ZXX [-1, 4, 2]
  6: ZXX [-1, 4, 3]
  7: ZXX [-1, 4, 4]
  0 -> +Y
  1 -H> +Y
  1 -> +Z
  3 -> +Z
  5 -> +Z
  6 -> +Z
  7 -> +Z

  topologiq_t_35 = measure 0 -> +Y
  resolve 4 if topologiq_t_35
  feedback X 1 -> +Y if topologiq_t_35

}
