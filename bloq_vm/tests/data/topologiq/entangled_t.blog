BLOG 1.0

module main {
  in in_0: data = 0
  in in_1: data = 1
  out out_0: data = 6
  out out_1: data = 7

  0: Port [0, 0, 0] role=input
  1: Port [0, 1, 0] role=input
  2: ZXX [0, 0, 1]
  3: ZZX [0, 1, 3]
  4: ZXX [0, 0, 3]
  5: ZXX [1, 0, 3]
  6: Port [0, 0, 6] role=output
  7: Port [1, -1, 5] role=output
  8: T [1, 0, 2]
  9: XY [1, 0, 4]
  10: ZXX [0, 0, 2]
  11: ZXX [0, 0, 4]
  12: ZXX [0, 0, 5]
  13: ZZX [1, 1, 3]
  14: ZXX [0, 2, 3]
  15: ZXX [0, 2, 2]
  16: ZXX [0, 2, 1]
  17: ZXX [0, 1, 1]
  18: ZXX [1, -1, 3]
  19: ZXX [1, -1, 4]
  0 -H> +Z
  1 -> +Z
  2 -> +Z
  3 -> +X
  3 -> +Y
  4 -> +Y
  4 -> +Z
  5 -> +Z
  5 -> +Y
  8 -> +Z
  10 -> +Z
  11 -> +Z
  12 -> +Z
  15 -> +Z
  16 -> +Z
  17 -> +Y
  18 -> +Y
  18 -> +Z
  19 -> +Z

  topologiq_t_5 = measure 13 -> -Y
  resolve 9 if !topologiq_t_5
  feedback X 5 -> -Y if topologiq_t_5

}
